# ==========================================
# APPLICATION
# ==========================================
APP_NAME=user-crud-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
POSTGRES_DB=user_crud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me # Must be changed in production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# SECURITY (JWT)
# ==========================================
# Use a strong key in production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=change-this-development-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30